{
  "manifest_version": 2,
  "name": "Zen Space Router",
  "version": "0.1.2",
  "description": "Routes incoming URLs to the right Zen workspace via container-tab rules.",
  "homepage_url": "https://github.com/tx2z/zen-space-router",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-space-router@caosmental.com",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/tx2z/zen-space-router/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "contextualIdentities",
    "storage",
    "cookies",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/rules.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
